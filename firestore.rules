rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == "azhaanahmed90@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    // 1. UserProfile Validation Helper
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
             data.activeRole is string && data.activeRole in ['SUPER_ADMIN', 'COLLEGE_ADMIN', 'FACULTY', 'STUDENT', 'PARENT'] &&
             data.institutionName is string && data.institutionName.size() >= 1 && data.institutionName.size() <= 160 &&
             data.department is string && data.department.size() >= 1 && data.department.size() <= 120 &&
             data.linkedStudentCode is string && data.linkedStudentCode.size() >= 1 && data.linkedStudentCode.size() <= 64 &&
             data.createdAt is timestamp &&
             isValidTimestamp(data.updatedAt);
    }

    // 2. StudentRecord Validation Helper
    function isValidStudentRecord(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.studentCode is string && data.studentCode.size() >= 1 && data.studentCode.size() <= 64 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
             data.department is string && data.department.size() >= 1 && data.department.size() <= 120 &&
             data.semester is int && data.semester >= 1 && data.semester <= 12 &&
             (data.cgpa is number) && data.cgpa >= 0 && data.cgpa <= 10 &&
             data.attendancePct is int && data.attendancePct >= 0 && data.attendancePct <= 100 &&
             data.feeStatus is string && data.feeStatus in ['PAID', 'PENDING', 'OVERDUE'] &&
             data.guardianName is string && data.guardianName.size() >= 1 && data.guardianName.size() <= 120 &&
             data.guardianPhone is string && data.guardianPhone.size() >= 3 && data.guardianPhone.size() <= 40 &&
             data.mentorName is string && data.mentorName.size() >= 1 && data.mentorName.size() <= 120 &&
             data.status is string && data.status in ['ACTIVE', 'INACTIVE'] &&
             data.createdAt is timestamp &&
             isValidTimestamp(data.updatedAt);
    }

    // 3. FacultyRecord Validation Helper
    function isValidFacultyRecord(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.facultyCode is string && data.facultyCode.size() >= 1 && data.facultyCode.size() <= 64 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
             data.department is string && data.department.size() >= 1 && data.department.size() <= 120 &&
             data.designation is string && data.designation.size() >= 1 && data.designation.size() <= 120 &&
             data.qualification is string && data.qualification.size() >= 1 && data.qualification.size() <= 160 &&
             data.assignedSubjects is string && data.assignedSubjects.size() >= 1 && data.assignedSubjects.size() <= 300 &&
             data.workloadHours is int && data.workloadHours >= 0 && data.workloadHours <= 60 &&
             data.experienceYears is int && data.experienceYears >= 0 && data.experienceYears <= 60 &&
             data.createdAt is timestamp &&
             isValidTimestamp(data.updatedAt);
    }

    // 4. AttendanceRecord Validation Helper
    function isValidAttendanceRecord(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.studentCode is string && data.studentCode.size() >= 1 && data.studentCode.size() <= 64 &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120 &&
             data.subjectCode is string && data.subjectCode.size() >= 1 && data.subjectCode.size() <= 64 &&
             data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 160 &&
             data.department is string && data.department.size() >= 1 && data.department.size() <= 120 &&
             data.semester is int && data.semester >= 1 && data.semester <= 12 &&
             data.sessionDate is string && data.sessionDate.size() >= 4 && data.sessionDate.size() <= 40 &&
             data.status is string && data.status in ['PRESENT', 'ABSENT', 'LATE'] &&
             data.method is string && data.method in ['QR_SCAN', 'MANUAL'] &&
             data.sessionToken is string && data.sessionToken.size() >= 1 && data.sessionToken.size() <= 128 &&
             data.createdAt is timestamp &&
             isValidTimestamp(data.updatedAt);
    }

    // 5. GrievanceRecord Validation Helper
    function isValidGrievanceRecord(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.ticketNumber is string && data.ticketNumber.size() >= 1 && data.ticketNumber.size() <= 64 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 1000 &&
             data.priority is string && data.priority in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'] &&
             data.status is string && data.status in ['SUBMITTED', 'UNDER_REVIEW', 'ASSIGNED', 'IN_PROGRESS', 'RESOLVED', 'REJECTED'] &&
             data.submittedBy is string && data.submittedBy.size() >= 1 && data.submittedBy.size() <= 120 &&
             data.assignedTo is string && data.assignedTo.size() >= 1 && data.assignedTo.size() <= 120 &&
             data.resolutionNotes is string && data.resolutionNotes.size() >= 1 && data.resolutionNotes.size() <= 1000 &&
             data.createdAt is timestamp &&
             isValidTimestamp(data.updatedAt);
    }

    // 6. CampusModuleItem Validation Helper
    function isValidCampusModuleItem(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.moduleType is string && data.moduleType in [
               'DEPARTMENT', 'COURSE', 'EXAM_RESULT', 'TIMETABLE', 'ASSIGNMENT',
               'FEE_INVOICE', 'NOTICE', 'FACILITY_BOOKING', 'CERTIFICATE',
               'EVENT', 'STUDY_GROUP', 'PLACEMENT', 'AUDIT_LOG'
             ] &&
             data.code is string && data.code.size() >= 1 && data.code.size() <= 64 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
             data.subtitle is string && data.subtitle.size() >= 1 && data.subtitle.size() <= 240 &&
             data.department is string && data.department.size() >= 1 && data.department.size() <= 120 &&
             data.semester is int && data.semester >= 0 && data.semester <= 12 &&
             data.status is string && data.status.size() >= 1 && data.status.size() <= 64 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
             (data.primaryMetric is number) && data.primaryMetric >= 0 && data.primaryMetric <= 10000000 &&
             data.secondaryMetric is int && data.secondaryMetric >= 0 && data.secondaryMetric <= 10000000 &&
             data.metadataText is string && data.metadataText.size() >= 1 && data.metadataText.size() <= 1500 &&
             data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 120 &&
             data.createdAt is timestamp &&
             isValidTimestamp(data.updatedAt);
    }

    // Collection 1: /users/{userId}
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin());
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'fullName', 'email', 'activeRole',
                         'institutionName', 'department', 'linkedStudentCode',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'fullName', 'email', 'activeRole',
                         'institutionName', 'department', 'linkedStudentCode',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'fullName', 'email', 'activeRole', 'institutionName',
                         'department', 'linkedStudentCode', 'updatedAt'
                       ]);

      allow delete: if isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin());
    }

    // Collection 2: /students/{studentId}
    match /students/{studentId} {
      allow get: if isSignedIn() && isValidId(studentId) && (existing().userId == request.auth.uid || isBootstrappedAdmin());
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(studentId) &&
                       incoming().keys().hasAll([
                         'userId', 'studentCode', 'fullName', 'email', 'department',
                         'semester', 'cgpa', 'attendancePct', 'feeStatus',
                         'guardianName', 'guardianPhone', 'mentorName', 'status',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'studentCode', 'fullName', 'email', 'department',
                         'semester', 'cgpa', 'attendancePct', 'feeStatus',
                         'guardianName', 'guardianPhone', 'mentorName', 'status',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidStudentRecord(incoming());

      allow update: if isSignedIn() &&
                       isValidId(studentId) &&
                       isValidStudentRecord(incoming()) &&
                       (existing().userId == request.auth.uid || isBootstrappedAdmin()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'studentCode', 'fullName', 'email', 'department',
                         'semester', 'cgpa', 'attendancePct', 'feeStatus',
                         'guardianName', 'guardianPhone', 'mentorName', 'status',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(studentId) && (existing().userId == request.auth.uid || isBootstrappedAdmin());
    }

    // Collection 3: /faculty/{facultyId}
    match /faculty/{facultyId} {
      allow get: if isSignedIn() && isValidId(facultyId) && (existing().userId == request.auth.uid || isBootstrappedAdmin());
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(facultyId) &&
                       incoming().keys().hasAll([
                         'userId', 'facultyCode', 'fullName', 'email', 'department',
                         'designation', 'qualification', 'assignedSubjects',
                         'workloadHours', 'experienceYears', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'facultyCode', 'fullName', 'email', 'department',
                         'designation', 'qualification', 'assignedSubjects',
                         'workloadHours', 'experienceYears', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidFacultyRecord(incoming());

      allow update: if isSignedIn() &&
                       isValidId(facultyId) &&
                       isValidFacultyRecord(incoming()) &&
                       (existing().userId == request.auth.uid || isBootstrappedAdmin()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'facultyCode', 'fullName', 'email', 'department',
                         'designation', 'qualification', 'assignedSubjects',
                         'workloadHours', 'experienceYears', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(facultyId) && (existing().userId == request.auth.uid || isBootstrappedAdmin());
    }

    // Collection 4: /attendance/{attendanceId}
    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && isValidId(attendanceId) && (existing().userId == request.auth.uid || isBootstrappedAdmin());
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(attendanceId) &&
                       incoming().keys().hasAll([
                         'userId', 'studentCode', 'studentName', 'subjectCode',
                         'subjectName', 'department', 'semester', 'sessionDate',
                         'status', 'method', 'sessionToken', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'studentCode', 'studentName', 'subjectCode',
                         'subjectName', 'department', 'semester', 'sessionDate',
                         'status', 'method', 'sessionToken', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidAttendanceRecord(incoming());

      allow update: if isSignedIn() &&
                       isValidId(attendanceId) &&
                       isValidAttendanceRecord(incoming()) &&
                       (existing().userId == request.auth.uid || isBootstrappedAdmin()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'method', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(attendanceId) && (existing().userId == request.auth.uid || isBootstrappedAdmin());
    }

    // Collection 5: /grievances/{grievanceId}
    match /grievances/{grievanceId} {
      allow get: if isSignedIn() && isValidId(grievanceId) && (existing().userId == request.auth.uid || isBootstrappedAdmin());
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(grievanceId) &&
                       incoming().keys().hasAll([
                         'userId', 'ticketNumber', 'title', 'category', 'description',
                         'priority', 'status', 'submittedBy', 'assignedTo',
                         'resolutionNotes', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'ticketNumber', 'title', 'category', 'description',
                         'priority', 'status', 'submittedBy', 'assignedTo',
                         'resolutionNotes', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidGrievanceRecord(incoming());

      allow update: if isSignedIn() &&
                       isValidId(grievanceId) &&
                       isValidGrievanceRecord(incoming()) &&
                       (existing().userId == request.auth.uid || isBootstrappedAdmin()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'category', 'description', 'priority',
                         'status', 'assignedTo', 'resolutionNotes', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(grievanceId) && (existing().userId == request.auth.uid || isBootstrappedAdmin());
    }

    // Collection 6: /campus_items/{itemId}
    match /campus_items/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId) && (existing().userId == request.auth.uid || isBootstrappedAdmin());
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(itemId) &&
                       incoming().keys().hasAll([
                         'userId', 'moduleType', 'code', 'title', 'subtitle',
                         'department', 'semester', 'status', 'category',
                         'primaryMetric', 'secondaryMetric', 'metadataText',
                         'ownerName', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'moduleType', 'code', 'title', 'subtitle',
                         'department', 'semester', 'status', 'category',
                         'primaryMetric', 'secondaryMetric', 'metadataText',
                         'ownerName', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidCampusModuleItem(incoming());

      allow update: if isSignedIn() &&
                       isValidId(itemId) &&
                       isValidCampusModuleItem(incoming()) &&
                       (existing().userId == request.auth.uid || isBootstrappedAdmin()) &&
                       incoming().userId == existing().userId &&
                       incoming().moduleType == existing().moduleType &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'code', 'title', 'subtitle', 'department', 'semester',
                         'status', 'category', 'primaryMetric', 'secondaryMetric',
                         'metadataText', 'ownerName', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(itemId) && (existing().userId == request.auth.uid || isBootstrappedAdmin());
    }
  }
}
